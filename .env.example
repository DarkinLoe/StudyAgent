# ====== Spring Boot 应用环境变量（示例）======
# Windows PowerShell 注入示例：
#   $env:AI_API_KEY='sk-xxxx'; $env:AI_BASE_URL='https://api.deepseek.com'; $env:AI_CHAT_MODEL='deepseek-chat'
#   .\scripts\mvn.ps1 spring-boot:run
# 或复制为 .env 后按工具链自行加载。

# OpenAI 兼容端点（DeepSeek / SiliconFlow / Moonshot / OpenAI 均可）
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=sk-your-key-here
AI_CHAT_MODEL=deepseek-chat
# embedding 模型按供应商能力选择，如 OpenAI text-embedding-3-small；
# SiliconFlow 可用 BAAI/bge-m3（base-url 需 /v1）
AI_EMBEDDING_MODEL=

# ====== MQ（默认关闭：文档摄入同步执行；开启则需 docker compose 的 rabbitmq 在线）======
STUDY_AGENT_MQ_ENABLED=false

# ====== docker compose 读取（docker-compose.yml 同目录 .env 自动生效）======
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=study_agent
MYSQL_PORT=3306
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
